# Copy to .env.local for local development, and set the same values as
# environment variables in your hosting dashboard for production.

# Signs the login tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# Postgres connection string. Leave empty locally to use a SQLite file instead.
DATABASE_URL=

# Optional: lets scripts/puzzles.py push new puzzles to the live site.
ADMIN_TOKEN=

# Optional: which day the "daily" puzzle rolls over on. Defaults to Europe/London.
PUZZLE_TZ=Europe/London
